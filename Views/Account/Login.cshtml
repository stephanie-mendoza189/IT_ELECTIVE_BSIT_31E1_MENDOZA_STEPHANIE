@model ModelBindingDemo.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<style>
    body {
        background: linear-gradient(135deg, #ffe6ea 0%, #ffccd5 100%);
        min-height: 100vh;
        font-family: 'Poppins', sans-serif;
    }

    .login-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        box-shadow: 0 8px 32px 0 rgba(255, 182, 193, 0.37);
        border: 1px solid rgba(255, 255, 255, 0.8);
        padding: 2.5rem;
        margin-top: 5rem;
    }

    .login-header h2 {
        color: #d63384;
        font-weight: 700;
    }

    .login-header p {
        color: #8c5366;
        font-size: 0.9rem;
    }

    .form-control {
        border-radius: 12px;
        border: 1.5px solid #f8c8dc;
        padding: 0.75rem 1rem;
        background-color: #fff0f3;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        border-color: #ff85a2;
        background-color: #ffffff;
        box-shadow: 0 0 0 0.25rem rgba(255, 133, 162, 0.25);
    }

    .form-label {
        color: #6b3a4c;
        font-weight: 600;
        margin-bottom: 0.4rem;
    }

    .btn-pink {
        background-color: #ff85a2;
        border: none;
        color: white;
        font-weight: 600;
        border-radius: 12px;
        padding: 0.75rem;
        width: 100%;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(255, 133, 162, 0.4);
    }

    .btn-pink:hover {
        background-color: #f76c8c;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(255, 133, 162, 0.5);
    }

    .text-pink-danger {
        color: #e63946;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .validation-summary-errors ul {
        list-style-type: none;
        padding-left: 0;
        margin-bottom: 0;
    }
</style>

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <div class="login-card">
            <div class="login-header text-center mb-4">
                <h2>Welcome Back! 🌸</h2>
                <p>Please enter your credentials to login</p>
            </div>

            <form asp-action="Login" method="post">
                
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 bg-light-danger text-pink-danger text-center mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" placeholder="Enter username" />
                    <span asp-validation-for="Username" class="text-pink-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" placeholder="Enter password" />
                    <span asp-validation-for="Password" class="text-pink-danger"></span>
                </div>

                <button type="submit" class="btn btn-pink">Login</button>
            </form>
        </div>
    </div>
</div> 